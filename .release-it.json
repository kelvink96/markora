{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        { "file": "src-tauri/tauri.conf.json", "path": "version" },
        { "file": "src-tauri/Cargo.toml", "path": "package.version" }
      ]
    }
  }
}
